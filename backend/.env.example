# 文档排版。生产环境使用 Gotenberg，本机可填 LibreOffice 的 soffice.com 或 soffice 路径。
GOTENBERG_URL=
LIBREOFFICE_BINARY=

# 登录来源。网段示例：10.8.0.0/16=北京实验室,10.9.0.0/16=上海办公室
AUDIT_LOCATION_NETWORKS=
# 填写负责覆盖 X-Real-IP 的反向代理地址。直接部署可留空。
AUDIT_TRUSTED_PROXIES=
# 自定义部署也可以指定可信反向代理的 DNS 主机名。
AUDIT_TRUSTED_PROXY_HOSTS=
# 可选离线城市库路径。本机开发启用前安装项目的 geoip 扩展依赖。
AUDIT_GEOIP_DATABASE=

# 周末邮件提醒。启用前填写成员可以访问的工作区网址、发件地址与 SMTP 服务信息。
ENABLE_WEEKLY_REMINDERS=false
WEEKLY_SITE_URL=
REMINDER_WEEKDAY=7
REMINDER_TIME=18:00
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# 桌宠对话与周报解析共用模型配置。OpenAI 兼容服务填写含 /v1 的地址。Ollama 填根地址和已安装的模型名。
ENABLE_LLM=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
# 在管理页面填写密钥，或将 manage.py encrypt_model_key 输出的密文填在这里。
LLM_API_KEY_ENCRYPTED=
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=100000
