# ── 应用环境变量模板 ─────────────────────────────────
# 复制为 deploy/config/app.env 并修改

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=weekly.example.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://weekly.example.internal
APP_TIME_ZONE=Asia/Shanghai

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=weekly_report
DATABASE_USER=weekly_app
DATABASE_PASSWORD=CHANGE-ME

REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
S3_BUCKET_ORIGINALS=weekly-originals
S3_BUCKET_PREVIEWS=weekly-previews
S3_BUCKET_EXPORTS=weekly-exports

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

MAX_UPLOAD_BYTES=104857600
MAX_REPORT_ATTACHMENT_BYTES=314572800

ENABLE_LLM=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
