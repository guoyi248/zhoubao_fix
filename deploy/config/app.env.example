# ── 应用环境变量模板 ─────────────────────────────────
# 复制为 deploy/config/app.env 并修改

DJANGO_SETTINGS_MODULE=config.settings.production
# 新安装由 setup.sh 生成；手工安装时将原主钥保存到 deploy/secrets/django/key。
# 旧部署继续使用现有 DJANGO_SECRET_KEY，它优先于文件。
DJANGO_SECRET_KEY_FILE=/run/secrets/weekly-django/key
DJANGO_ALLOWED_HOSTS=weekly.example.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://weekly.example.internal
APP_TIME_ZONE=Asia/Shanghai

# 登录来源。填写可信代理 IP/网段，nginx 覆盖的 X-Real-IP 才会生效。
AUDIT_TRUSTED_PROXIES=
# 内置生产 Compose 已指定可信代理主机 nginx，自定义部署可指定其他主机。
# 例如 10.8.0.0/16=北京实验室,10.9.0.0/16=上海办公室
AUDIT_LOCATION_NETWORKS=
# 可选，容器可读的 GeoLite2-City.mmdb 路径
AUDIT_GEOIP_DATABASE=

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=weekly_report
DATABASE_USER=weekly_app
DATABASE_PASSWORD=CHANGE-ME

REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
S3_BUCKET_ORIGINALS=weekly-originals
S3_BUCKET_PREVIEWS=weekly-previews
S3_BUCKET_EXPORTS=weekly-exports

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

MAX_UPLOAD_BYTES=104857600
MAX_REPORT_ATTACHMENT_BYTES=314572800

# 周末邮件提醒。启用前填写成员可以访问的工作区网址、发件地址与 SMTP 服务信息。
ENABLE_WEEKLY_REMINDERS=false
WEEKLY_SITE_URL=
REMINDER_WEEKDAY=7
REMINDER_TIME=18:00
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# 桌宠对话与周报解析共用模型配置。OpenAI 兼容服务填写含 /v1 的地址。Ollama 填 API 容器可访问的根地址和已安装的模型名。
ENABLE_LLM=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=
# 可在管理页面填写密钥，或使用 manage.py encrypt_model_key 生成的密文。
LLM_API_KEY_ENCRYPTED=
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=100000
